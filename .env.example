# Copy this file to .env and adjust values as needed.
# .env is git-ignored - never commit real secrets.

APP_NAME=JeevanSetu AI - Public Health Chatbot
ENVIRONMENT=development
DEBUG=True

CORS_ORIGINS=*

# --- MongoDB (M2: Backend) ---
# Local dev example:  mongodb://localhost:27017
# MongoDB Atlas example: mongodb+srv://<username>:<password>@<cluster-url>/
# Never commit a real URI with credentials - this file only holds placeholders.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=jeevansetu

# --- M1: AI / RAG (Google Gemini API) ---
# Get a key from https://aistudio.google.com/apikey - required for
# /api/v1/chat to return real AI responses. Without it, /chat falls
# back to a safe error message instead of crashing.
AI_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
VECTOR_DB_URL=

# --- M3: WhatsApp / SMS (fill in when integrating) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_GATEWAY_API_KEY=